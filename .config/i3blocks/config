# Global settings
command=/usr/libexec/i3blocks/$BLOCK_NAME
separator_block_width=20
markup=none

[cpu]
label=CPU 
command=top -bn1 | awk -F'[, ]+' '/%Cpu\(s\)/ {printf "%.0f%%\n", 100-$8}'
interval=3
color=#f3bc82

[memory]
label=RAM 
command=free -h | awk '/Mem:/ { print $3 "/" $2 }'
interval=5
color=#e99b65

# click = mute, scroll = volume, right click = pavucontrol
[volume]
command=~/.config/i3blocks/scripts/volume
interval=5
signal=10
color=#e9a35f

# icon only, click = nmtui
[wifi]
command=~/.config/i3blocks/scripts/wifi
interval=10
color=#e99b65

# click = switch between % and time left
[battery]
command=~/.config/i3blocks/scripts/battery
interval=10
color=#cd8660

[time]
label=
command=date '+%Y-%m-%d  %H:%M:%S'
interval=1
color=#e2d3c6
