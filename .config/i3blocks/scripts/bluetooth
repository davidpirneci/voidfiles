#!/bin/bash
# i3blocks: bluetooth (bluez / bluetoothctl)
# left click = power on/off, right click = bluetuith in foot, or bluetoothctl if bluetuith isn't installed
case "$BLOCK_BUTTON" in
  1) if bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
       bluetoothctl power off >/dev/null
     else
       bluetoothctl power on >/dev/null
     fi ;;
  3) if command -v bluetuith >/dev/null; then setsid -f foot -e bluetuith >/dev/null 2>&1
     else setsid -f foot -e bluetoothctl >/dev/null 2>&1; fi ;;
esac

show=$(bluetoothctl show 2>/dev/null)
if [[ -z $show ]]; then                       # bluetoothd not running / no adapter
  echo '󰂲'; echo; echo "#8a8580"; exit 0
fi
if ! grep -q 'Powered: yes' <<<"$show"; then
  echo '󰂲 off'; echo; echo "#8a8580"; exit 0
fi

names=()
while read -r _ mac _; do
  [[ -n $mac ]] || continue
  name=$(bluetoothctl info "$mac" | sed -n 's/^\s*Alias: //p')
  names+=("${name:-$mac}")
done < <(bluetoothctl devices Connected 2>/dev/null)

if (( ${#names[@]} )); then
  joined=$(IFS=,; echo "${names[*]}"); joined=${joined//,/, }
  echo '󰂱'" $joined"; echo '󰂱'" ${#names[@]}"
else
  echo '󰂯 on'
fi
