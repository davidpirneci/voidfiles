#!/bin/bash
# i3blocks: wifi, icon only (signal bars). Click = nmtui in a floating foot.
case "$BLOCK_BUTTON" in
  1|3) if command -v nmtui >/dev/null; then
         setsid -f foot --app-id=floating-term -e nmtui >/dev/null 2>&1
       else
         setsid -f foot --app-id=floating-term -e iwctl >/dev/null 2>&1
       fi ;;
esac

dev=${WIFI_DEV:-$(basename "$(dirname "$(ls -d /sys/class/net/*/wireless 2>/dev/null | head -n1)")")}
if [[ -z $dev || $dev == . ]]; then echo '󰤮 '; echo; echo "#8a8580"; exit 0; fi

state=$(cat "/sys/class/net/$dev/operstate" 2>/dev/null)
if [[ $state != up ]]; then echo '󰤮 '; echo; echo "#8a8580"; exit 0; fi

# link quality is out of 70 on most drivers
q=$(awk -v d="$dev:" '$1==d {gsub(/\./,"",$3); print int($3*100/70)}' ${PROC_WIRELESS:-/proc/net/wireless})
q=${q:-0}
if   (( q >= 80 )); then echo '󰤨 '
elif (( q >= 60 )); then echo '󰤥 '
elif (( q >= 40 )); then echo '󰤢 '
elif (( q >= 20 )); then echo '󰤟 '
else                     echo '󰤯 '
fi
